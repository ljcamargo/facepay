{
  "name": "facepay-mx",
  "private": true,
  "version": "0.0.0",
  "description": "Face-linked POS payments for Mexico over CoDi (pey.mx API)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @facepay/web dev",
    "build": "pnpm --filter @facepay/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:rls": "supabase test db",
    "supabase": "supabase",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "functions:serve": "supabase functions serve --env-file supabase/.env.local",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ]
}
