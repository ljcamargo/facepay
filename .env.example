# ─────────────────────────────────────────────────────────────────────────────
# FacePay MX — environment template
# Copy to .env.local (web) and supabase/.env.local (functions).
# NEVER commit real values. Values left empty here on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web (Next.js, public — exposed to the browser) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=

# ── Supabase Edge Functions (server-only secrets) ────────────────────────────
# Stored with: supabase secrets set --env-file supabase/.env.production
PEY_API_KEY=
PEY_API_BASE=https://api.pey.mx
PEY_WEBHOOK_SECRET=
PEY_BANK_ACCOUNT_ID=
CRON_SECRET=
APP_URL=http://localhost:3000

# Face matching defaults (per-store overrides live in the stores table)
FACE_MIN_SIMILARITY=0.60
FACE_MIN_MARGIN=0.08
FACE_MIN_LIVENESS=0.75
FACE_MIN_QUALITY=0.60
FACE_MODEL=human-hse-faceres
FACE_MODEL_VERSION=3.3.6

# Optional: custom SMS provider through the Supabase Send SMS Hook
SMS_PROVIDER_KEY=

# ── Local tooling only ───────────────────────────────────────────────────────
# Used by scripts/ (never by the app)
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
TEST_PHONE_E164=+525512345678
